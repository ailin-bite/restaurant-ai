# Скопируйте в backend/.env и подставьте свой ключ
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Пороги правил (этап 5)
KITCHEN_LOAD_WARNING_PCT=70
KITCHEN_LOAD_CRITICAL_PCT=85
WAIT_WARNING_MIN=18
WAIT_CRITICAL_MIN=25
STAFF_LOAD_WARNING_PCT=80

# Окно измерения результата принятой рекомендации, минуты
IMPACT_WINDOW_MIN=20
